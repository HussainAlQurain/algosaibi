{# Photo album. Expects: navLang ("en"|"ar"), assetPrefix ("" | "../") #}
{% set isAr = navLang == "ar" %}
<section class="section photo-album-section" id="galleries">
  <div class="container">
    <div class="section-head centered reveal">
      <p class="eyebrow">{{ 'ألبوم الصور' if isAr else 'Photo Album' }}</p>
      <h2>{{ galleries.albumTitleAr if isAr else galleries.albumTitleEn }}</h2>
      <p class="section-lead">{{ galleries.albumLeadAr if isAr else galleries.albumLeadEn }}</p>
    </div>

    <div class="photo-album reveal delay-1" data-gallery-group>
      {% for image in galleries.images %}
      <button
        type="button"
        class="photo-album__item"
        data-gallery-trigger
        data-full="{{ assetPrefix }}{{ image.src }}"
        data-alt="{{ image.altAr if isAr else image.altEn }}"
        aria-label="{{ image.altAr if isAr else image.altEn }}"
      >
        <span class="photo-album__frame">
          <span class="photo-album__photo">
            <img src="{{ assetPrefix }}{{ image.src }}" alt="{{ image.altAr if isAr else image.altEn }}" loading="lazy" decoding="async" />
          </span>
          <span class="photo-album__caption">{{ image.altAr if isAr else image.altEn }}</span>
        </span>
      </button>
      {% endfor %}
    </div>
  </div>
</section>

<div class="gallery-lightbox" id="galleryLightbox" hidden aria-hidden="true">
  <div class="gallery-lightbox__backdrop" data-gallery-close tabindex="-1"></div>
  <div class="gallery-lightbox__dialog" role="dialog" aria-modal="true" aria-label="{{ 'عرض الصورة' if isAr else 'Image viewer' }}">
    <button type="button" class="gallery-lightbox__close" data-gallery-close aria-label="{{ 'إغلاق' if isAr else 'Close' }}">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--prev" data-gallery-prev aria-label="{{ 'الصورة السابقة' if isAr else 'Previous image' }}">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--next" data-gallery-next aria-label="{{ 'الصورة التالية' if isAr else 'Next image' }}">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>
    <figure class="gallery-lightbox__figure">
      <img class="gallery-lightbox__img" src="" alt="" />
      <figcaption class="gallery-lightbox__caption"></figcaption>
    </figure>
    <p class="gallery-lightbox__counter" data-gallery-counter aria-live="polite"></p>
  </div>
</div>
